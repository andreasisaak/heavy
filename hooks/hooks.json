{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/build.sh",
              "guard"
            ],
            "timeout": 300
          }
        ]
      },
      {
        "matcher": "TaskStop|KillShell",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/build.sh",
              "stop"
            ],
            "timeout": 300
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/build.sh",
              "session-start"
            ],
            "timeout": 300
          }
        ]
      }
    ]
  }
}
